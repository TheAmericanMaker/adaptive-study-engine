{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SourceSectionMap",
  "description": "Generated by scripts/build-index.py. Maps domains/sections to source content.",
  "type": "object",
  "required": [
    "version",
    "sourceRepo",
    "domains",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string"
    },
    "sourceRepo": {
      "type": "string"
    },
    "domains": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_-]*$": {
          "type": "object",
          "required": [
            "name",
            "weight",
            "sections"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "weight": {
              "type": "number"
            },
            "sections": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "sourceSection",
          "title",
          "domain",
          "contentFile",
          "originalFile",
          "subsections"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "domain": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "contentFile": {
            "type": "string"
          },
          "originalFile": {
            "type": "string"
          },
          "subsections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "title"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              }
            }
          },
          "sourceSection": {
            "type": "integer"
          }
        }
      }
    }
  }
}
